        <div class="font-light text-lg text-black dark:text-neutral-100" style="letter-spacing: -0.3px;">
          {SITE.NAME}
        </div>
      </Link>
      <nav class="flex gap-1">
        <Link href="/blog">
          博客
        </Link>
        <span>
          {`/`}
        </span>
        <Link href="/work">
          工作
        </Link>
        <span>
          {`/`}
        </span>
        <Link href="/projects">
          项目
        </Link>
      </nav>
    </div>
  </Container>
</header>
