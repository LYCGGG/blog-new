---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn("inline-block text-current hover:text-black dark:hover:text-neutral-100 transition-colors duration-300 ease-in-out", underline && "underline underline-offset-2 decoration-warm-gray/40 hover:decoration-black/50 dark:decoration-neutral-600 dark:hover:decoration-neutral-400")}
  {...rest}>
  <slot/>
</a>
