---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).filter(post => !post.data.draft);

// Build a map: dateString -> [{title, slug}]
const postsByDate: Record<string, { title: string; slug: string }[]> = {};
posts.forEach(post => {
  const dateStr = post.data.date.toISOString().split("T")[0];
  if (!postsByDate[dateStr]) postsByDate[dateStr] = [];
  postsByDate[dateStr].push({ title: post.data.title, slug: post.slug });
});

// Generate 52 weeks ending today
const today = new Date();
const DAY_MS = 86400000;
const totalDays = 364;
const startDate = new Date(today.getTime() - (totalDays - 1) * DAY_MS);

// Align start to Sunday
const startDay = startDate.getDay();
const alignedStart = new Date(startDate.getTime() - startDay * DAY_MS);
const alignedTotal = Math.ceil((today.getTime() - alignedStart.getTime()) / DAY_MS) + 1;

interface DayCell {
  date: string;
  count: number;
  posts: { title: string; slug: string }[];
  future: boolean;
}

const weeks: DayCell[][] = [];
let currentWeek: DayCell[] = [];

for (let i = 0; i < alignedTotal; i++) {
  const d = new Date(alignedStart.getTime() + i * DAY_MS);
  const dateStr = d.toISOString().split("T")[0];
  const isFuture = d > today;
  const dayPosts = postsByDate[dateStr] || [];
  currentWeek.push({ date: dateStr, count: dayPosts.length, posts: dayPosts, future: isFuture });
  if (currentWeek.length === 7) {
    weeks.push(currentWeek);
    currentWeek = [];
  }
}
if (currentWeek.length > 0) weeks.push(currentWeek);

const months = ["1月","2月","3月","4月","5月","6月","7月","8月","9月","10月","11月","12月"];
type MonthLabel = { label: string; col: number };
const monthLabels: MonthLabel[] = [];
let lastMonth = -1;
weeks.forEach((week, wi) => {
  const m = new Date(week[0].date).getMonth();
  if (m !== lastMonth) {
    monthLabels.push({ label: months[m], col: wi });
    lastMonth = m;
  }
});

const totalPosts = posts.length;
const weekCount = weeks.length;
---

<div class="heatmap-wrap">
  <div class="heatmap-header">
    <span class="heatmap-title">写作热力图</span>
    <span class="heatmap-count">{totalPosts} 篇文章（过去一年）</span>
  </div>

  <div class="heatmap-outer">
    <!-- Month labels row -->
    <div class="heatmap-months">
      <div class="heatmap-label-spacer"></div>
      <div class="heatmap-months-row">
        {monthLabels.map(ml => (
          <span style={`grid-column: ${ml.col + 1}`}>{ml.label}</span>
        ))}
      </div>
    </div>

    <div class="heatmap-main">
      <!-- Day of week labels -->
      <div class="heatmap-days">
        <span></span><span>一</span><span></span><span>三</span><span></span><span>五</span><span></span>
      </div>

      <!-- The grid -->
      <div class="heatmap-grid">
        {weeks.map(week =>
          week.map(day => (
            <div
              class:list={[
                "hc",
                day.future && "fut",
                !day.future && day.count === 0 && "l0",
                day.count === 1 && "l1",
                day.count === 2 && "l2",
                day.count >= 3 && "l3",
              ]}
              data-heatmap-cell
              data-date={day.date}
              data-count={day.count}
              data-posts={JSON.stringify(day.posts.map(p => p.title))}
              role="gridcell"
              aria-label={`${day.date}: ${day.count} 篇文章`}
            />
          ))
        )}
      </div>
    </div>
  </div>

  <!-- Legend -->
  <div class="heatmap-legend">
    <span>少</span>
    <div class="hc l0"></div>
    <div class="hc l1"></div>
    <div class="hc l2"></div>
    <div class="hc l3"></div>
    <span>多</span>
  </div>
</div>

<style define:vars={{ weekCount: weekCount.toString() }}>
  .heatmap-wrap {
    position: relative;
    padding: 0.5rem 0;
  }
  .heatmap-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .heatmap-title {
    font-size: 0.875rem;
    font-weight: 400;
    color: #4e4e4e;
  }
  :global(html.dark) .heatmap-title { color: #a3a3a3; }
  .heatmap-count {
    font-size: 0.75rem;
    color: #999;
  }
  :global(html.dark) .heatmap-count { color: #666; }

  .heatmap-outer {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Month labels */
  .heatmap-months {
    display: flex;
    gap: 3px;
  }
  .heatmap-label-spacer {
    width: 28px;
    flex-shrink: 0;
  }
  .heatmap-months-row {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(var(--weekCount), minmax(0, 1fr));
    font-size: 0.7rem;
    color: #aaa;
  }
  :global(html.dark) .heatmap-months-row { color: #555; }

  /* Main area: day labels + grid */
  .heatmap-main {
    display: flex;
    gap: 3px;
  }
  .heatmap-days {
    width: 28px;
    flex-shrink: 0;
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    font-size: 0.65rem;
    color: #aaa;
    text-align: right;
    padding-right: 4px;
    align-items: center;
  }
  :global(html.dark) .heatmap-days { color: #555; }

  /* Grid: columns = weeks, rows = 7 days, auto-flow column */
  .heatmap-grid {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    grid-template-columns: repeat(var(--weekCount), minmax(0, 1fr));
    grid-auto-flow: column;
    gap: 2px;
  }

  /* Each cell: square via aspect-ratio, fill its grid cell */
  .hc {
    aspect-ratio: 1;
    width: 100%;
    border-radius: 2px;
    cursor: default;
    transition: outline 0.15s ease;
  }
  .hc:hover:not(.fut) {
    outline: 1.5px solid rgba(0,0,0,0.35);
    outline-offset: -0.5px;
  }
  :global(html.dark) .hc:hover:not(.fut) {
    outline-color: rgba(255,255,255,0.35);
  }

  .l0 { background: #ebedf0; }
  .l1 { background: #9be9a8; }
  .l2 { background: #40c463; }
  .l3 { background: #216e39; }
  :global(html.dark) .l0 { background: #161b22; }
  :global(html.dark) .l1 { background: #0e4429; }
  :global(html.dark) .l2 { background: #006d32; }
  :global(html.dark) .l3 { background: #26a641; }

  .fut {
    opacity: 0;
    pointer-events: none;
  }

  .heatmap-legend {
    display: flex;
    align-items: center;
    gap: 3px;
    justify-content: flex-end;
    margin-top: 6px;
    font-size: 0.65rem;
    color: #aaa;
  }
  :global(html.dark) .heatmap-legend { color: #555; }
  .heatmap-legend .hc {
    width: 10px;
    height: 10px;
    max-width: none;
  }


</style>

<script is:inline>
  function initHeatmap() {
    // Remove old tooltip if exists (ViewTransitions re-run)
    var old = document.getElementById("heatmap-tip");
    if (old) old.remove();

    // Create tooltip on body
    var tip = document.createElement("div");
    tip.id = "heatmap-tip";
    tip.style.cssText = "position:fixed;display:none;padding:6px 10px;font-size:0.72rem;line-height:1.5;border-radius:6px;pointer-events:none;z-index:9999;max-width:260px;white-space:pre-line;background:#fff;color:#333;border:1px solid #e0e0e0;box-shadow:0 2px 8px rgba(0,0,0,0.12)";
    document.body.appendChild(tip);

    // Dark mode style
    if (document.documentElement.classList.contains("dark")) {
      tip.style.background = "#2d2d2d";
      tip.style.color = "#e0e0e0";
      tip.style.borderColor = "#444";
    }

    var cells = document.querySelectorAll("[data-heatmap-cell]");
    cells.forEach(function(cell) {
      cell.addEventListener("mouseenter", function() {
        // Update dark/light on hover
        var isDark = document.documentElement.classList.contains("dark");
        tip.style.background = isDark ? "#2d2d2d" : "#fff";
        tip.style.color = isDark ? "#e0e0e0" : "#333";
        tip.style.borderColor = isDark ? "#444" : "#e0e0e0";

        var date = cell.getAttribute("data-date");
        var count = parseInt(cell.getAttribute("data-count") || "0");
        var posts = JSON.parse(cell.getAttribute("data-posts") || "[]");

        var text = date + "\n";
        text += count === 0 ? "没有文章" : count + " 篇文章";
        if (posts.length) text += "\n" + posts.map(function(t) { return "• " + t; }).join("\n");

        tip.textContent = text;
        tip.style.display = "block";
        tip.style.left = "-9999px";
        tip.style.top = "-9999px";

        // Force reflow to get correct dimensions
        void tip.offsetWidth;

        var tw = tip.offsetWidth;
        var th = tip.offsetHeight;
        var r = cell.getBoundingClientRect();

        var left = r.left + r.width / 2 - tw / 2;
        var top = r.top - th - 8;

        if (left < 4) left = 4;
        if (left + tw > window.innerWidth - 4) left = window.innerWidth - tw - 4;
        if (top < 4) top = r.bottom + 8;

        tip.style.left = left + "px";
        tip.style.top = top + "px";
      });

      cell.addEventListener("mouseleave", function() {
        tip.style.display = "none";
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initHeatmap);
  document.addEventListener("astro:page-load", initHeatmap);
</script>
